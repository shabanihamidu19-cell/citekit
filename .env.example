# Public URL of your deployed site (used for sitemap, canonical URLs, Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string, 32+ chars. Signs the plan + usage cookies.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Stripe (use TEST keys first). Leave empty to run in demo mode locally.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Set to 1 ONLY if you want the "activate demo plan" button to work in production.
DEMO_MODE=
